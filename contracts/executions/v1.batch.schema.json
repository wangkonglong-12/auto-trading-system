    "Identity": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,96}$",
          "title": "Account Id",
          "type": "string"
        },
        "environment": {
          "enum": [
            "REAL",
            "TEST"
          ],
          "title": "Environment",
          "type": "string"
        },
        "selection_date": {
          "format": "date",
          "title": "Selection Date",
          "type": "string"
        },
        "strategy_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,96}$",
          "title": "Strategy Id",
