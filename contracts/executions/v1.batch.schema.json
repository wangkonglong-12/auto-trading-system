        },
        "client_order_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,96}$",
          "title": "Client Order Id",
          "type": "string"
        },
        "filled_quantity": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Filled Quantity",
          "type": "integer"
