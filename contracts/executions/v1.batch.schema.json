        "kind": {
          "const": "ORDER",
          "title": "Kind",
          "type": "string"
        },
        "price": {
          "pattern": "^(0|[1-9][0-9]{0,9})(\\.[0-9]{1,8})?$",
          "title": "Price",
          "type": "string"
        },
        "quantity": {
          "maximum": 2147483647,
