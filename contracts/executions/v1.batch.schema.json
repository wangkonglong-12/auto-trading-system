    "node_id": {
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$",
      "title": "Node Id",
      "type": "string"
    },
    "schema_version": {
      "maximum": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "strategy_id": {
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$",
