{
  "$comment": "Generated from protocol/executions; semantic validators and projection constraints also apply.",
  "$defs": {
    "CancelFailure": {
      "additionalProperties": false,
      "properties": {
        "broker_order_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,96}$",
          "title": "Broker Order Id",
          "type": "string"
        },
        "client_order_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,96}$",
          "title": "Client Order Id",
          "type": "string"
        },
        "kind": {
          "const": "CANCEL_ERROR",
          "title": "Kind",
          "type": "string"
        },
        "reason_code": {
          "pattern": "^[A-Za-z0-9_.:-]{1,96}$",
          "title": "Reason Code",
          "type": "string"
        },
        "side": {
          "enum": [
            "BUY",
            "SELL"
          ],
          "title": "Side",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "client_order_id",
        "broker_order_id",
        "side",
        "reason_code"
      ],
      "title": "CancelFailure",
      "type": "object"
    },
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "CANDIDATE",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Name"
        },
        "phase": {
          "enum": [
            "1440",
            "1445",
            "1450"
          ],
          "title": "Phase",
          "type": "string"
        },
        "source_run_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,96}$",
          "title": "Source Run Id",
          "type": "string"
        },
        "target_amount": {
          "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{2}$",
          "title": "Target Amount",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "phase",
        "source_run_id",
        "name",
        "target_amount"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "fact": {
          "discriminator": {
            "mapping": {
              "CANCEL_ERROR": "#/$defs/CancelFailure",
              "CANDIDATE": "#/$defs/Candidate",
              "ORDER": "#/$defs/OrderFact",
              "PROGRESS": "#/$defs/Progress",
              "REQUEST_ERROR": "#/$defs/RequestFailure",
              "SUBMISSION": "#/$defs/SubmissionFact",
              "TRADE": "#/$defs/TradeFact"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Candidate"
            },
            {
              "$ref": "#/$defs/Progress"
            },
            {
              "$ref": "#/$defs/SubmissionFact"
            },
            {
              "$ref": "#/$defs/OrderFact"
            },
            {
              "$ref": "#/$defs/TradeFact"
            },
            {
              "$ref": "#/$defs/CancelFailure"
            },
            {
              "$ref": "#/$defs/RequestFailure"
            }
          ],
          "title": "Fact"
        },
        "identity": {
          "$ref": "#/$defs/Identity"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "seq": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "source_key": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Source Key",
          "type": "string"
        }
      },
      "required": [
        "identity",
        "source_key",
        "occurred_at",
        "fact",
        "seq"
      ],
      "title": "Event",
      "type": "object"
