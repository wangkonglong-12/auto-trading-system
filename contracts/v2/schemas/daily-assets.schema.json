{
  "additionalProperties": false,
  "properties": {
    "account_id": {
      "description": "内部账户标识，必须与上传清单一致",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$",
      "title": "Account Id",
      "type": "string"
    },
    "cash_available": {
      "description": "人民币元，最多2位小数",
      "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,2})?$",
      "title": "Cash Available",
      "type": "string"
    },
    "cash_frozen": {
      "description": "人民币元，最多2位小数",
      "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,2})?$",
      "title": "Cash Frozen",
      "type": "string"
    },
    "currency": {
      "const": "CNY",
      "default": "CNY",
      "title": "Currency",
      "type": "string"
    },
    "market_value": {
      "description": "人民币元，最多2位小数",
      "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,2})?$",
      "title": "Market Value",
      "type": "string"
    },
    "observed_at": {
      "description": "该条事实的观测时点",
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "quality": {
      "enum": [
        "CONFIRMED",
        "INDETERMINATE"
      ],
      "title": "Quality",
      "type": "string"
    },
    "snapshot_id": {
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "total_equity": {
      "description": "人民币元，最多2位小数",
      "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,2})?$",
      "title": "Total Equity",
      "type": "string"
    },
    "trade_date": {
      "description": "所属交易日",
      "format": "date",
      "title": "Trade Date",
      "type": "string"
    }
  },
  "required": [
    "account_id",
    "trade_date",
    "observed_at",
    "snapshot_id",
    "cash_available",
    "cash_frozen",
    "market_value",
    "total_equity",
    "quality"
  ],
  "title": "AssetRecord",
  "type": "object"
}
