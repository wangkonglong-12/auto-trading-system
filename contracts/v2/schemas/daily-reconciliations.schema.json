{
  "additionalProperties": false,
  "properties": {
    "account_id": {
      "description": "内部账户标识，必须与上传清单一致",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$",
      "title": "Account Id",
      "type": "string"
    },
    "amount_difference": {
      "anyOf": [
        {
          "description": "有符号人民币元",
          "pattern": "^-?(0|[1-9][0-9]{0,11})(\\.[0-9]{1,2})?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Amount Difference"
    },
    "expected_quantity": {
      "anyOf": [
        {
          "description": "整数股",
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Quantity"
    },
    "observed_at": {
      "description": "该条事实的观测时点",
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "observed_quantity": {
      "anyOf": [
        {
          "description": "整数股",
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observed Quantity"
    },
    "reason_code": {
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$",
      "title": "Reason Code",
      "type": "string"
    },
    "reconciliation_id": {
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$",
      "title": "Reconciliation Id",
      "type": "string"
    },
    "related_ids": {
      "default": [],
      "items": {
        "pattern": "^[A-Za-z0-9_.:-]{1,96}$",
        "type": "string"
      },
      "maxItems": 200,
      "title": "Related Ids",
      "type": "array"
    },
    "scope": {
      "enum": [
        "ORDERS",
        "TRADES",
        "POSITIONS",
        "CASH",
        "DAILY"
      ],
      "title": "Scope",
      "type": "string"
    },
    "status": {
      "enum": [
        "MATCHED",
        "DISCREPANCY",
        "INDETERMINATE"
      ],
      "title": "Status",
      "type": "string"
    },
    "symbol": {
      "anyOf": [
        {
          "description": "带市场后缀的证券代码",
          "pattern": "^[0-9]{6}\\.(SH|SZ|BJ)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Symbol"
    },
    "trade_date": {
      "description": "所属交易日",
      "format": "date",
      "title": "Trade Date",
      "type": "string"
    }
  },
  "required": [
    "account_id",
    "trade_date",
    "observed_at",
    "reconciliation_id",
    "scope",
    "status",
    "reason_code"
  ],
  "title": "ReconciliationRecord",
  "type": "object"
}
