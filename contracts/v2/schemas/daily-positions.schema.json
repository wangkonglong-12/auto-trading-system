{
  "additionalProperties": false,
  "properties": {
    "account_id": {
      "description": "内部账户标识，必须与上传清单一致",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$",
      "title": "Account Id",
      "type": "string"
    },
    "attribution_status": {
      "enum": [
        "MATCHED",
        "UNEXPLAINED",
        "MANUAL"
      ],
      "title": "Attribution Status",
      "type": "string"
    },
    "available_quantity": {
      "description": "整数股",
      "maximum": 2147483647,
      "minimum": 0,
      "title": "Available Quantity",
      "type": "integer"
    },
    "cost_amount": {
      "anyOf": [
        {
          "description": "人民币元，最多2位小数",
          "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,2})?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "未知成本为空，不能填零代替",
      "title": "Cost Amount"
    },
    "frozen_quantity": {
      "description": "整数股",
      "maximum": 2147483647,
      "minimum": 0,
      "title": "Frozen Quantity",
      "type": "integer"
    },
    "market_value": {
      "description": "人民币元，最多2位小数",
      "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,2})?$",
      "title": "Market Value",
      "type": "string"
    },
    "observed_at": {
      "description": "该条事实的观测时点",
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "snapshot_id": {
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "strategy_quantity": {
      "description": "整数股",
      "maximum": 2147483647,
      "minimum": 0,
      "title": "Strategy Quantity",
      "type": "integer"
    },
    "symbol": {
      "description": "带市场后缀的证券代码",
      "pattern": "^[0-9]{6}\\.(SH|SZ|BJ)$",
      "title": "Symbol",
      "type": "string"
    },
    "total_quantity": {
      "description": "整数股",
      "maximum": 2147483647,
      "minimum": 0,
      "title": "Total Quantity",
      "type": "integer"
    },
    "trade_date": {
      "description": "所属交易日",
      "format": "date",
      "title": "Trade Date",
      "type": "string"
    }
  },
  "required": [
    "account_id",
    "trade_date",
    "observed_at",
    "snapshot_id",
    "symbol",
    "total_quantity",
    "available_quantity",
    "frozen_quantity",
    "strategy_quantity",
    "market_value",
    "attribution_status"
  ],
  "title": "PositionRecord",
  "type": "object"
}
