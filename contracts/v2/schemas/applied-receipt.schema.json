{
  "additionalProperties": false,
  "properties": {
    "account_id": {
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$",
      "title": "Account Id",
      "type": "string"
    },
    "applied_at": {
      "format": "date-time",
      "title": "Applied At",
      "type": "string"
    },
    "batch_id": {
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$",
      "title": "Batch Id",
      "type": "string"
    },
    "business_status": {
      "enum": [
        "COMPLETE",
        "INCOMPLETE"
      ],
      "title": "Business Status",
      "type": "string"
    },
    "financial_status": {
      "enum": [
        "PROVISIONAL",
        "SETTLED"
      ],
      "title": "Financial Status",
      "type": "string"
    },
    "manifest_hash": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Manifest Hash",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "state": {
      "const": "APPLIED",
      "default": "APPLIED",
      "title": "State",
      "type": "string"
    },
    "trade_date": {
      "format": "date",
      "title": "Trade Date",
      "type": "string"
    }
  },
  "required": [
    "batch_id",
    "account_id",
    "trade_date",
    "revision",
    "manifest_hash",
    "business_status",
    "financial_status",
    "applied_at"
  ],
  "title": "AppliedReceipt",
  "type": "object"
}
