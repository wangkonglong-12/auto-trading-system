{
  "additionalProperties": false,
  "properties": {
    "account_id": {
      "description": "内部账户标识，必须与上传清单一致",
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$",
      "title": "Account Id",
      "type": "string"
    },
    "broker_order_id": {
      "pattern": "^[A-Za-z0-9_.:-]{1,96}$",
      "title": "Broker Order Id",
      "type": "string"
    },
    "cancelled_quantity": {
      "description": "整数股",
      "maximum": 2147483647,
      "minimum": 0,
      "title": "Cancelled Quantity",
      "type": "integer"
    },
    "client_order_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9_.:-]{1,96}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Client Order Id"
    },
    "filled_quantity": {
      "description": "整数股",
      "maximum": 2147483647,
      "minimum": 0,
      "title": "Filled Quantity",
      "type": "integer"
    },
    "limit_price": {
      "description": "每股人民币元，最多8位小数",
      "pattern": "^(0|[1-9][0-9]{0,9})(\\.[0-9]{1,8})?$",
      "title": "Limit Price",
      "type": "string"
    },
    "market": {
      "enum": [
        "SH",
        "SZ",
        "BJ"
      ],
      "title": "Market",
      "type": "string"
    },
    "observed_at": {
      "description": "该条事实的观测时点",
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "quantity": {
      "description": "整数股",
      "maximum": 2147483647,
      "minimum": 0,
      "title": "Quantity",
      "type": "integer"
    },
    "raw_status": {
      "description": "券商原始状态值原文",
      "maxLength": 96,
      "minLength": 1,
      "title": "Raw Status",
      "type": "string"
    },
    "remark_token": {
      "default": "",
      "maxLength": 24,
      "title": "Remark Token",
      "type": "string"
    },
    "side": {
      "enum": [
        "BUY",
        "SELL"
      ],
      "title": "Side",
      "type": "string"
    },
    "status": {
      "enum": [
        "ACTIVE",
        "PARTIAL",
        "FILLED",
        "CANCELLED",
        "REJECTED",
        "UNKNOWN"
      ],
      "title": "Status",
      "type": "string"
    },
    "symbol": {
      "description": "带市场后缀的证券代码",
      "pattern": "^[0-9]{6}\\.(SH|SZ|BJ)$",
      "title": "Symbol",
      "type": "string"
    },
    "trade_date": {
      "description": "所属交易日",
      "format": "date",
      "title": "Trade Date",
      "type": "string"
    }
  },
  "required": [
    "account_id",
    "trade_date",
    "observed_at",
    "broker_order_id",
    "market",
    "symbol",
    "side",
    "quantity",
    "filled_quantity",
    "cancelled_quantity",
    "limit_price",
    "status",
    "raw_status"
  ],
  "title": "BrokerOrderRecord",
  "type": "object"
}
