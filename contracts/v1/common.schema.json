{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.auto-trading.local/v1/common.schema.json",
  "title": "Trading Protocol Common Definitions v1.0",
  "$defs": {
    "schemaVersion": {"const": "1.0"},
    "requestId": {"type": "string", "pattern": "^req_[0-9a-f]{32}$"},
    "nodeId": {"type": "string", "pattern": "^node-[a-z0-9][a-z0-9-]{2,47}$"},
    "accountId": {"type": "string", "pattern": "^acct_[A-Za-z0-9_-]{3,48}$"},
    "bootId": {"type": "string", "pattern": "^boot_[0-9a-f]{32}$"},
    "snapshotId": {"type": "string", "pattern": "^(asset|position)_[A-Za-z0-9_-]{8,64}$"},
    "reconciliationId": {"type": "string", "pattern": "^recon_[A-Za-z0-9_-]{8,64}$"},
    "heartbeatId": {"type": "string", "pattern": "^heartbeat_[A-Za-z0-9_-]{8,64}$"},
    "commandId": {"type": "string", "pattern": "^cmd_[A-Za-z0-9_-]{8,64}$"},
    "resultId": {"type": "string", "pattern": "^cmdres_[A-Za-z0-9_-]{8,64}$"},
    "contentHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reasonCode": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
    "tradeDate": {"type": "string", "format": "date"},
    "shanghaiDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?\\+08:00$"
    },
    "securityCode": {"type": "string", "pattern": "^[0-9]{6}\\.(SH|SZ|BJ)$"},
    "quantity": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "positiveQuantity": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "money": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,13})(\\.[0-9]{1,2})?$"
    },
    "price": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,9})(\\.[0-9]{1,8})?$"
    },
    "queryStatus": {"enum": ["AVAILABLE", "QUERY_FAILED", "UNKNOWN"]},
    "brokerAccountStatus": {
      "enum": ["OK", "CONNECTING", "LOGGING_IN", "FAILED", "CORRECTING", "CLOSED", "DISABLED", "UNKNOWN"]
    },
    "runtimeState": {
      "enum": [
        "BOOTING", "CONNECTING", "RECONCILING", "READY_PAUSED", "AUTO",
        "PAUSE_BUY", "SELL_ONLY", "MANUAL", "HALT", "STOPPING", "STOPPED"
      ]
    },
    "executionMode": {
      "enum": ["READ_ONLY", "PAPER", "SHADOW", "ASSISTED", "LIVE_EXIT_ONLY", "LIVE"]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"$ref": "#/$defs/reasonCode"},
        "message": {"type": "string", "minLength": 1, "maxLength": 512},
        "retryable": {"type": "boolean"}
      }
    }
  }
}
