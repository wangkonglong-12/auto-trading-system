{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.auto-trading.local/v1/asset-snapshot.schema.json",
  "title": "AssetSnapshot v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "snapshot_id", "request_id", "node_id", "account_id",
    "trade_date", "as_of", "query_status", "broker_account_status"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "snapshot_id": {"type": "string", "pattern": "^asset_[A-Za-z0-9_-]{8,64}$"},
    "request_id": {"$ref": "common.schema.json#/$defs/requestId"},
    "node_id": {"$ref": "common.schema.json#/$defs/nodeId"},
    "account_id": {"$ref": "common.schema.json#/$defs/accountId"},
    "trade_date": {"$ref": "common.schema.json#/$defs/tradeDate"},
    "as_of": {"$ref": "common.schema.json#/$defs/shanghaiDateTime"},
    "query_status": {"$ref": "common.schema.json#/$defs/queryStatus"},
    "broker_account_status": {"$ref": "common.schema.json#/$defs/brokerAccountStatus"},
    "asset": {"$ref": "#/$defs/asset"},
    "error": {"$ref": "common.schema.json#/$defs/error"}
  },
  "allOf": [
    {
      "if": {"properties": {"query_status": {"const": "AVAILABLE"}}, "required": ["query_status"]},
      "then": {"required": ["asset"], "not": {"required": ["error"]}},
      "else": {"required": ["error"], "not": {"required": ["asset"]}}
    }
  ],
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cash", "frozen_cash", "market_value", "total_asset"],
      "properties": {
        "cash": {"$ref": "common.schema.json#/$defs/money"},
        "frozen_cash": {"$ref": "common.schema.json#/$defs/money"},
        "market_value": {"$ref": "common.schema.json#/$defs/money"},
        "total_asset": {"$ref": "common.schema.json#/$defs/money"},
        "fetch_balance": {"$ref": "common.schema.json#/$defs/money"},
        "current_balance": {"$ref": "common.schema.json#/$defs/money"}
      }
    }
  }
}
