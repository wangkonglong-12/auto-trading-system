{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.auto-trading.local/v1/plan-ack-request.schema.json",
  "title": "PlanAckRequest v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "node_id",
    "account_id",
    "boot_id",
    "plan_id",
    "plan_hash",
    "ack_status",
    "runtime_mode",
    "reject_reasons",
    "occurred_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "node_id": {
      "type": "string",
      "pattern": "^node_[A-Za-z0-9_-]{3,48}$"
    },
    "account_id": {
      "type": "string",
      "pattern": "^acct_[A-Za-z0-9_-]{3,48}$"
    },
    "boot_id": {
      "type": "string",
      "pattern": "^boot_[A-Za-z0-9_-]{8,64}$"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^plan_[A-Za-z0-9_-]{8,64}$"
    },
    "plan_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ack_status": {
      "enum": ["ACCEPTED", "REJECTED", "STARTED", "COMPLETED", "CANCELLED", "EXPIRED"]
    },
    "runtime_mode": {
      "enum": [
        "BOOTING",
        "CONNECTING",
        "RECONCILING",
        "READY_PAUSED",
        "AUTO",
        "SELL_ONLY",
        "MANUAL",
        "HALT"
      ]
    },
    "reject_reasons": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          },
          "message": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    },
    "occurred_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?\\+08:00$"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"ack_status": {"const": "REJECTED"}}},
      "then": {"properties": {"reject_reasons": {"minItems": 1}}},
      "else": {"properties": {"reject_reasons": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"ack_status": {"const": "ACCEPTED"}}},
      "then": {"properties": {"runtime_mode": {"const": "READY_PAUSED"}}}
    }
  ]
}
