{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.auto-trading.local/v1/runtime-command-batch.schema.json",
  "title": "RuntimeCommandBatch v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "request_id", "node_id", "account_id", "generated_at",
    "after_command_seq", "high_watermark", "next_poll_after_ms", "commands"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "request_id": {"$ref": "common.schema.json#/$defs/requestId"},
    "node_id": {"$ref": "common.schema.json#/$defs/nodeId"},
    "account_id": {"$ref": "common.schema.json#/$defs/accountId"},
    "generated_at": {"$ref": "common.schema.json#/$defs/shanghaiDateTime"},
    "after_command_seq": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "high_watermark": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "next_poll_after_ms": {"type": "integer", "minimum": 250, "maximum": 60000},
    "commands": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "runtime-command.schema.json"}
    }
  }
}
