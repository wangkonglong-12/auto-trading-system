{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.auto-trading.local/v1/runtime-heartbeat.schema.json",
  "title": "RuntimeHeartbeat v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "heartbeat_id", "request_id", "node_id", "account_id", "boot_id",
    "heartbeat_seq", "trade_date", "sent_at", "execution_mode", "runtime_state",
    "connectivity", "health", "versions", "degraded_reasons"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "heartbeat_id": {"$ref": "common.schema.json#/$defs/heartbeatId"},
    "request_id": {"$ref": "common.schema.json#/$defs/requestId"},
    "node_id": {"$ref": "common.schema.json#/$defs/nodeId"},
    "account_id": {"$ref": "common.schema.json#/$defs/accountId"},
    "boot_id": {"$ref": "common.schema.json#/$defs/bootId"},
    "heartbeat_seq": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "trade_date": {"$ref": "common.schema.json#/$defs/tradeDate"},
    "sent_at": {"$ref": "common.schema.json#/$defs/shanghaiDateTime"},
    "execution_mode": {"$ref": "common.schema.json#/$defs/executionMode"},
    "runtime_state": {"$ref": "common.schema.json#/$defs/runtimeState"},
    "connectivity": {"$ref": "#/$defs/connectivity"},
    "health": {"$ref": "#/$defs/health"},
    "versions": {"$ref": "#/$defs/versions"},
    "last_reconciliation_id": {
      "oneOf": [{"$ref": "common.schema.json#/$defs/reconciliationId"}, {"type": "null"}]
    },
    "degraded_reasons": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/reasonCode"}
    }
  },
  "$defs": {
    "connectivity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qmt", "broker_account", "central_api", "market_data"],
      "properties": {
        "qmt": {"enum": ["CONNECTED", "DISCONNECTED", "RECONNECTING", "UNKNOWN"]},
        "broker_account": {"$ref": "common.schema.json#/$defs/brokerAccountStatus"},
        "central_api": {"enum": ["REACHABLE", "DEGRADED", "UNREACHABLE"]},
        "market_data": {"enum": ["HEALTHY", "STALE", "UNAVAILABLE", "UNKNOWN"]}
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "journal", "event_queue_depth", "event_queue_capacity", "writer_queue_depth",
        "writer_queue_capacity", "outbox_pending", "oldest_outbox_at", "active_orders",
        "subscribed_symbols", "wal_bytes", "disk_free_bytes", "clock_offset_ms"
      ],
      "properties": {
        "journal": {"enum": ["HEALTHY", "DEGRADED", "UNAVAILABLE"]},
        "event_queue_depth": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "event_queue_capacity": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "writer_queue_depth": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "writer_queue_capacity": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "outbox_pending": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "oldest_outbox_at": {
          "oneOf": [{"$ref": "common.schema.json#/$defs/shanghaiDateTime"}, {"type": "null"}]
        },
        "active_orders": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "subscribed_symbols": {"type": "integer", "minimum": 0, "maximum": 50},
        "wal_bytes": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "disk_free_bytes": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "clock_offset_ms": {"type": "integer", "minimum": -86400000, "maximum": 86400000}
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "config_hash", "python", "qmt", "xtquant"],
      "properties": {
        "runtime": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[A-Za-z0-9.-]+)?$"},
        "config_hash": {"$ref": "common.schema.json#/$defs/contentHash"},
        "python": {"type": "string", "minLength": 3, "maxLength": 32},
        "qmt": {"type": "string", "minLength": 1, "maxLength": 96},
        "xtquant": {"type": "string", "minLength": 1, "maxLength": 96}
      }
    }
  }
}
